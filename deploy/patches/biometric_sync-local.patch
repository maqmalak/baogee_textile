+MACHINE_DEFAULTS = {
+	"default_import_from": "sync_from", "default_sync_interval": "sync_interval", "default_log_type_mode": "log_type_mode",
+	"default_time_offset": "time_offset_minutes", "default_port": "port", "default_comm_key": "comm_key", "default_timeout": "timeout",
+	"default_force_udp": "force_udp", "default_ping_before_connect": "ping_before_connect",
+	"default_disable_device_during_sync": "disable_device_during_sync", "default_sync_device_time": "sync_device_time",
+}
+
+
+@frappe.whitelist()
+def settings():
+	_can_read()
+	_require_unlocked()
+	doc = frappe.get_single("Biometric Sync Settings")
+	values = {k: doc.get(k) for k in SETTINGS_FIELDS if doc.meta.has_field(k)}
+	for k, v in values.items():
+		if hasattr(v, "isoformat"):
+			values[k] = str(v)
+	devices = frappe.get_all("Biometric Device", ["name", "device_name", "auto_sync", "sync_interval", "sync_from", "last_punch_time", "enabled"])
+	return {
+		"values": values,
+		"console_password_enabled": bool(cint(doc.console_password_enabled)),
+		"scheduler": {"site": frappe.local.site, "enabled": not is_scheduler_disabled(verbose=False),
+			"can_toggle": "System Manager" in frappe.get_roles()},
+		"machines": [{"id": d.name, "name": d.device_name, "auto_sync": bool(cint(d.auto_sync)), "enabled": bool(cint(d.enabled)),
+			"sync_interval": cint(d.sync_interval), "sync_from": _ts(d.sync_from), "last_punch_time": _ts(d.last_punch_time)} for d in devices],
+		"site": frappe.local.site,
+	}
+
+
+@frappe.whitelist(methods=["POST"])
+def settings_save(values):
+	_can_write()
+	_require_unlocked()
+	values = _parse(values) or {}
+	doc = frappe.get_single("Biometric Sync Settings")
+	for k, v in values.items():
+		if k in SETTINGS_FIELDS and doc.meta.has_field(k):
+			doc.set(k, v)
+	doc.save()
+	return settings()
+
+
+@frappe.whitelist(methods=["POST"])
+def apply_machine_defaults(fields=None):
+	"""Copy machine defaults (all, or the given settings fields) to every machine."""
+	_can_write()
+	_require_unlocked()
+	doc = frappe.get_single("Biometric Sync Settings")
+	fields = _parse(fields) or list(MACHINE_DEFAULTS)
+	values = {}
+	for f in fields:
+		target = MACHINE_DEFAULTS.get(f)
+		if not target:
+			continue
+		v = doc.get(f)
+		if f == "default_import_from":
+			v = f"{v} 00:00:00" if v else None
+		elif v in (None, ""):
+			continue
+		values[target] = v
+	names = frappe.get_all("Biometric Device", pluck="name")
+	for n in names:
+		frappe.db.set_value("Biometric Device", n, values, update_modified=True)
+	return {"machines": len(names), "fields": list(values)}
+
+
+@frappe.whitelist(methods=["POST"])
+def set_machines_auto_sync(enabled, interval=None):
+	"""Automatic reading on / off (and the interval) for every machine at once."""
+	_can_write()
+	_require_unlocked()
+	values = {"auto_sync": cint(enabled)}
+	if cint(interval):
+		values["sync_interval"] = cint(interval)
+	names = frappe.get_all("Biometric Device", {"protocol": ["in", PULL_PROTOCOLS]}, pluck="name")
+	for n in names:
+		frappe.db.set_value("Biometric Device", n, values)
+	return {"machines": len(names)}
+
+
+@frappe.whitelist(methods=["POST"])
+def set_site_scheduler(enabled):
+	"""The site's background scheduler (every scheduled job of this site, not only Biometric Sync)."""
+	_can_write()
+	_require_unlocked()
+	frappe.only_for("System Manager")
+	from frappe.utils.scheduler import disable_scheduler, enable_scheduler
+
+	enable_scheduler() if cint(enabled) else disable_scheduler()
+	return {"enabled": not is_scheduler_disabled(verbose=False)}
+
+
+# ---------------------------------------------------------------- console password
+@frappe.whitelist(methods=["POST"])
+def set_console_password(password, current=None):
+	_can_write()
+	_require_unlocked()
+	if len(cstr(password)) < 4:
+		frappe.throw(_("Use at least 4 characters."))
+	_lock_settings_row()
+	doc = frappe.get_single("Biometric Sync Settings")
+	if cint(doc.console_password_enabled) and not _check_password(current):
+		frappe.throw(_("The current console password is wrong."))
+	from frappe.utils.password import set_encrypted_password
+
+	set_encrypted_password(doc.doctype, doc.name, password, "console_password")
+	frappe.db.set_single_value(doc.doctype, {"console_password": "*" * 8, "console_password_enabled": 1})
+	frappe.cache.set_value(_unlock_key(), 1, expires_in_sec=UNLOCK_TTL)
+	return {"enabled": True}
+
+
+@frappe.whitelist(methods=["POST"])
+def remove_console_password(current):
+	_can_write()
+	_require_unlocked()
+	_lock_settings_row()
+	if not _check_password(current):
+		frappe.throw(_("The current console password is wrong."))
+	frappe.db.set_single_value("Biometric Sync Settings", {"console_password": None, "console_password_enabled": 0})
+	return {"enabled": False}
+
+
+def _lock_settings_row():
+	"""Serialize password changes: a second request (e.g. a double-submitted form) waits here instead of
+	deadlocking with the first on tabSingles / __Auth."""
+	frappe.db.sql("select value from tabSingles where doctype = %s and field = 'console_password_enabled' for update",
+		"Biometric Sync Settings")
+
+
+def _check_password(pwd):
+	from frappe.utils.password import get_decrypted_password
+
+	saved = get_decrypted_password("Biometric Sync Settings", "Biometric Sync Settings", "console_password", raise_exception=False)
+	import hmac
+
+	return bool(saved) and hmac.compare_digest(cstr(saved), cstr(pwd))
+
+
+@frappe.whitelist(methods=["POST"])
+def unlock(password):
+	_can_read(check_lock=False)
+	if not _check_password(password):
+		frappe.throw(_("Wrong password."), title=_("Locked"))  # not AuthenticationError: that would end the login session
+	frappe.cache.set_value(_unlock_key(), 1, expires_in_sec=UNLOCK_TTL)
+	return {"ok": True}
+
+
+@frappe.whitelist(methods=["POST"])
+def lock():
+	_can_read(check_lock=False)
+	frappe.cache.delete_value(_unlock_key())
+	return {"ok": True}
diff --git a/biometric_sync/display.py b/biometric_sync/display.py
new file mode 100644
index 0000000..fc5c80c
--- /dev/null
+++ b/biometric_sync/display.py
@@ -0,0 +1,222 @@
+"""Check-in Display: live board of the day's punches (Employee Checkin), ported from the local
+biometric-attendance-sync tool's /#/display. Served at /checkin-display; settings live in
+Biometric Sync Settings → Check-in Display.
+
+`today()` returns the same shape the local tool's /api/display/today did, so its screen code runs unchanged."""
+import re
+from datetime import datetime, timedelta
+
+import frappe
+from frappe.utils import cint, get_datetime, now_datetime
+
+REPEAT_SCAN_SECONDS = 180  # scans of one person closer than this count as one
+SETTING_KEYS = ("display_title", "display_language", "display_view", "display_direction", "display_day_start",
+	"display_show_photos", "display_urdu_names", "display_show_division", "display_show_department",
+	"display_show_sub_department", "display_show_designation", "display_recent_count", "display_refresh_seconds")
+TS = "%Y-%m-%d %H:%M:%S"
+
+
+def _has(doctype, field):
+	return frappe.get_meta(doctype).has_field(field)
+
+
+def _urdu_col():
+	"""Employee's Urdu name column when the site has one (e.g. baogee_textile's mm_urdu_name)."""
+	return "e.mm_urdu_name" if _has("Employee", "mm_urdu_name") else "null"
+
+
+def _check_access():
+	if frappe.session.user == "Guest":
+		raise frappe.PermissionError
+	if not frappe.has_permission("Employee Checkin", "read"):
+		raise frappe.PermissionError
+
+
+@frappe.whitelist()
+def settings():
+	_check_access()
+	s = frappe.get_cached_doc("Biometric Sync Settings")
+	out = {k: s.get(k) for k in SETTING_KEYS}
+	for k in SETTING_KEYS:
+		if k.startswith("display_show") or k == "display_urdu_names":
+			out[k] = bool(cint(out[k]))
+	out["display_day_start"] = str(out["display_day_start"] or "00:00")[:5]
+	out["display_recent_count"] = cint(out["display_recent_count"]) or 40
+	out["display_refresh_seconds"] = max(5, cint(out["display_refresh_seconds"]) or 30)
+	return out
+
+
+@frappe.whitelist()
+def devices():
+	"""Machines for the filter: every device_id seen on punches, named from Biometric Device where it exists."""
+	_check_access()
+	names = {d.checkin_device_id or d.name: d.device_name or d.name
+		for d in frappe.get_all("Biometric Device", ["name", "device_name", "checkin_device_id"])}
+	ids = frappe.db.sql_list("""select distinct device_id from `tabEmployee Checkin`
+		where ifnull(device_id, '') != '' and time > now() - interval 60 day""")
+	return [{"id": i, "name": names.get(i, i)} for i in sorted(set(ids) | set(names))]
+
+
+def _org(departments, dept):
+	"""Division / Department / Sub Department (+ Urdu) from the department tree (Department.mm_level)."""
+	out = {}
+	seen = 0
+	while dept and dept in departments and seen < 6:
+		d = departments[dept]
+		level = {"Division": "division", "Department": "department", "Sub Department": "sub_department"}.get(d.get("mm_level"))
+		if level and level not in out:
+			out[level] = d.department_name
+			out[level + "_ur"] = d.get("mm_urdu_name")
+		dept, seen = d.parent_department, seen + 1
+	if not out and dept:
+		out["department"] = departments.get(dept, {}).get("department_name") or dept
+	return out
+
+
+@frappe.whitelist()
+def today(date: str | None = None, device: str | None = None, limit: int = 40):
+	_check_access()
+	s = settings()
+	sh, sm = (int(x) for x in (s["display_day_start"] if re.fullmatch(r"\d{2}:\d{2}", s["display_day_start"]) else "00:00").split(":"))
+	now = now_datetime()
+	if date:
+		if not re.fullmatch(r"\d{4}-\d{2}-\d{2}", date):
+			frappe.throw("Invalid date.")
+		day = date
+	else:
+		cur = now if (now.hour, now.minute) >= (sh, sm) else now - timedelta(days=1)
+		day = cur.strftime("%Y-%m-%d")
+	win_start = datetime.strptime(day, "%Y-%m-%d").replace(hour=sh, minute=sm)
+	win_end = win_start + timedelta(days=1) - timedelta(seconds=1)
+
+	cond, params = "c.time between %(a)s and %(b)s", {"a": win_start, "b": win_end}
+	if device:
+		cond += " and c.device_id = %(dev)s"
+		params["dev"] = device
+	rows = frappe.db.sql(f"""select c.name, c.employee, c.time, c.log_type, c.device_id, e.employee_name, {_urdu_col()} mm_urdu_name,
+			e.attendance_device_id, e.department, e.designation, e.image, e.status emp_status
+		from `tabEmployee Checkin` c left join tabEmployee e on e.name = c.employee
+		where {cond} order by c.time, c.name""", params, as_dict=True)
+
+	dfields = ["name", "department_name", "parent_department"] + [f for f in ("mm_level", "mm_urdu_name") if _has("Department", f)]
+	departments = {d.name: d for d in frappe.get_all("Department", dfields)} if rows else {}
+	desig_ur = dict(frappe.get_all("Designation", ["name", "mm_urdu_name"], as_list=True)) if rows and _has("Designation", "mm_urdu_name") else {}
+	dev_names = {d["id"]: d["name"] for d in devices()} if rows else {}
+	alternate = s["display_direction"] == "alternate"
+
+	people, recent = {}, []
+	for r in rows:
+		org = _org(departments, r.department)
+		key = r.employee or r.device_id
+		p = {
+			"id": r.name, "user_id": r.attendance_device_id or r.employee, "ts": r.time.strftime(TS),
+			"sync_status": "synced", "reason": None, "device_name": dev_names.get(r.device_id, r.device_id),
+			"employee_id": r.employee, "employee_name": r.employee_name, "device_user_name": None,
+			"employee_name_ur": r.mm_urdu_name, "designation": r.designation, "designation_ur": desig_ur.get(r.designation),
+			"division": org.get("division"), "division_ur": org.get("division_ur"),
+			"department": org.get("department"), "department_ur": org.get("department_ur"),
+			"sub_department": org.get("sub_department"), "sub_department_ur": org.get("sub_department_ur"),
+			"photo": r.image or None,
+		}
+		person = people.setdefault(key, {**{k: p[k] for k in ("user_id", "employee_id", "employee_name_ur", "designation",
+			"designation_ur", "division", "division_ur", "department", "department_ur", "sub_department", "sub_department_ur",
+			"photo")}, "name": r.employee_name, "punches": 0, "first_in": None, "last_out": None, "last_ts": None,
+			"last_type": None, "last_device": None, "_active": r.emp_status == "Active"})
+		t, guessed = r.log_type, False
+		if alternate or not t:
+			last = person.get("_last_dt")
+			if last and (r.time - last).total_seconds() < REPEAT_SCAN_SECONDS and person["last_type"]:
+				t = person["last_type"]
+			else:
+				t = "IN" if person.get("_turns", 0) % 2 == 0 else "OUT"
+				person["_turns"] = person.get("_turns", 0) + 1
+			person["_last_dt"] = r.time
+			guessed = not alternate
+		p["type"], p["type_guessed"] = t, guessed
+		person["punches"] += 1
+		if t == "IN" and not person.get("_open"):
+			person["_open"] = r.time
+		elif t == "OUT" and person.get("_open"):
+			person["_worked"] = person.get("_worked", 0) + int((r.time - person.pop("_open")).total_seconds())
+		if t == "IN" and not person["first_in"]:
+			person["first_in"] = p["ts"]
+		if t == "OUT":
+			person["last_out"] = p["ts"]
+		person["last_ts"], person["last_type"], person["last_device"] = p["ts"], t, p["device_name"]
+		recent.append(p)
+
+	is_today = win_start <= now <= win_end
+	present_active = 0
+	for person in people.values():
+		person["status"] = "in" if person["last_type"] == "IN" else "out"
+		worked, open_ts = person.pop("_worked", None), person.pop("_open", None)
+		person["worked_running"] = False
+		if open_ts and is_today:
+			worked = (worked or 0) + max(0, int((now - open_ts).total_seconds()))
+			person["worked_running"] = True
+		person["worked_seconds"] = worked
+		present_active += 1 if person.pop("_active") else 0
+		for k in ("_last_dt", "_turns"):
+			person.pop(k, None)
+
+	active = frappe.db.count("Employee", {"status": "Active", "attendance_device_id": ["is", "set"]})
+	plist = sorted(people.values(), key=lambda x: x["last_ts"] or "", reverse=True)
+	limit = max(1, min(cint(limit) or 40, 200))
+	return {
+		"date": day,
+		"is_today": is_today,
+		"window": [win_start.strftime(TS), win_end.strftime(TS)],
+		"previous": _previous(win_start, device) if not rows else None,
+		"summary": {
+			"punches": len(rows), "present": len(people),
+			"in": sum(1 for x in plist if x["status"] == "in"), "out": sum(1 for x in plist if x["status"] == "out"),
+			"active_employees": active, "present_active": present_active,
+			"unlinked": max(0, len(people) - present_active),
+			"absent": max(0, active - present_active) if active else None,
+			"synced": len(rows), "pending": 0, "failed": 0,
+		},
+		"recent": list(reversed(recent[-limit:])),
+		"people": plist,
+		"last_read_at": _last_read(),
+		"live": {"enabled": False, "machines": []},
+		"service": _service(),
+	}
+
+
+def _previous(before, device):
+	cond, params = "c.time < %(b)s", {"b": before}
+	if device:
+		cond += " and c.device_id = %(dev)s"
+		params["dev"] = device
+	r = frappe.db.sql(f"""select c.name, c.employee, c.time, c.log_type, c.device_id, e.employee_name, {_urdu_col()} mm_urdu_name,
+			e.attendance_device_id, e.designation, e.image
+		from `tabEmployee Checkin` c left join tabEmployee e on e.name = c.employee
+		where {cond} order by c.time desc limit 1""", params, as_dict=True)
+	if not r:
+		return None
+	r = r[0]
+	return {"id": r.name, "user_id": r.attendance_device_id or r.employee, "ts": r.time.strftime(TS), "type": r.log_type,
+		"type_guessed": False, "sync_status": "synced", "device_name": r.device_id, "employee_id": r.employee,
+		"employee_name": r.employee_name, "employee_name_ur": r.mm_urdu_name, "designation": r.designation,
+		"photo": r.image or None}
+
+
+def _last_read():
+	"""When punches last arrived: the newest Biometric Device sync, else the newest check-in."""
+	t = frappe.db.sql("select max(last_sync_at) from `tabBiometric Device` where enabled = 1")[0][0]
+	c = frappe.db.sql("select max(creation) from `tabEmployee Checkin`")[0][0]
+	best = max([x for x in (t, c) if x], default=None)
+	return best.strftime(TS) if best else None
+
+
+def _service():
+	"""Status bar: machines configured in Biometric Sync and their last sync."""
+	devs = frappe.get_all("Biometric Device", {"enabled": 1}, ["device_name", "status", "last_sync_at", "last_sync_status", "last_error"])
+	last = max((d for d in devs if d.last_sync_at), key=lambda d: d.last_sync_at, default=None)
+	return {
+		"started_at": None, "version": None, "syncing": False, "erp_configured": True,
+		"erp_down_since": None, "erp_last_error": None, "pending_total": 0, "failed_total": 0,
+		"last_sync": {"status": "success" if (last.last_sync_status or "").lower().startswith("success") else "failed",
+			"finished_at": get_datetime(last.last_sync_at).strftime(TS), "trigger": "schedule"} if last else None,
+		"devices": [{"name": d.device_name, "status": d.status, "last_sync_at": str(d.last_sync_at or ""), "last_error": d.last_error} for d in devs],
+	}
diff --git a/biometric_sync/public/display/core.js b/biometric_sync/public/display/core.js
new file mode 100644
index 0000000..2e6bee1
--- /dev/null
+++ b/biometric_sync/public/display/core.js
@@ -0,0 +1,355 @@
+/* Core helpers: API, formatting, toasts, modals, live updates */
+'use strict';
+
+const $ = (sel, root = document) => root.querySelector(sel);
+const $$ = (sel, root = document) => Array.from(root.querySelectorAll(sel));
+const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
+
+const Pages = {};
+const store = {
+  runs: new Map(),      // active runs: id -> snapshot
+  settings: null,
+  devices: null,
+  info: null,
+  connected: false,
+  listeners: {},
+};
+
+/* ---------- events ---------- */
+function on(evt, fn) { (store.listeners[evt] ||= new Set()).add(fn); return () => store.listeners[evt].delete(fn); }
+function emit(evt, data) { (store.listeners[evt] || []).forEach((fn) => { try { fn(data); } catch (e) { console.error(e); } }); }
+
+/* ---------- API ---------- */
+class ApiError extends Error {
+  constructor(message, status, detail) { super(message); this.status = status; this.detail = detail; }
+}
+async function api(path, { method = 'GET', body, raw = false } = {}) {
+  const opts = { method, headers: {}, credentials: 'same-origin' };
+  if (body !== undefined) { opts.headers['Content-Type'] = 'application/json'; opts.body = JSON.stringify(body); }
+  let res;
+  try { res = await fetch('/api' + path, opts); }
+  catch (e) { throw new ApiError('Cannot reach the attendance sync service. Is it running?', 0); }
+  if (res.status === 401 && !path.startsWith('/auth')) { showLogin(); throw new ApiError('Login required', 401); }
+  if (raw) { if (!res.ok) throw new ApiError(await errText(res), res.status); return res; }
+  const text = await res.text();
+  let data = null;
+  try { data = text ? JSON.parse(text) : null; } catch { data = text; }
+  if (!res.ok) {
+    let msg = (data && data.detail) || res.statusText || 'Request failed';
+    if (Array.isArray(msg)) msg = msg.map((d) => `${(d.loc || []).slice(1).join('.')}: ${d.msg}`).join('; ');
+    throw new ApiError(msg, res.status, data && data.error_detail);
+  }
+  return data;
+}
+async function errText(res) { try { const d = await res.json(); return d.detail || res.statusText; } catch { return res.statusText; } }
+
+async function download(path, body, fallbackName) {
+  const res = await api(path, { method: body ? 'POST' : 'GET', body, raw: true });
+  const blob = await res.blob();
+  const cd = res.headers.get('Content-Disposition') || '';
+  const m = cd.match(/filename="?([^"]+)"?/);
+  const a = document.createElement('a');
+  a.href = URL.createObjectURL(blob);
+  a.download = m ? m[1] : fallbackName;
+  document.body.appendChild(a); a.click(); a.remove();
+  setTimeout(() => URL.revokeObjectURL(a.href), 2000);
+}
+
+/* ---------- formatting ---------- */
+function fmtBytes(n, digits = 1) {
+  n = Number(n || 0);
+  if (n < 1024) return `${n} B`;
+  const u = ['KB', 'MB', 'GB', 'TB']; let i = -1;
+  do { n /= 1024; i++; } while (n >= 1024 && i < u.length - 1);
+  return `${n.toFixed(n >= 100 ? 0 : digits)} ${u[i]}`;
+}
+function fmtNum(n) { return Number(n || 0).toLocaleString(); }
+function fmtDuration(s) {
+  if (s == null || isNaN(s)) return '—';
+  s = Math.max(0, Math.round(s));
+  if (s < 60) return `${s}s`;
+  const m = Math.floor(s / 60), sec = s % 60;
+  if (m < 60) return `${m}m ${String(sec).padStart(2, '0')}s`;
+  const h = Math.floor(m / 60);
+  return `${h}h ${String(m % 60).padStart(2, '0')}m`;
+}
+function parseTs(ts) { return ts ? new Date(String(ts).replace(' ', 'T')) : null; }
+function fmtDate(ts, withSeconds = false) {
+  const d = parseTs(ts); if (!d || isNaN(d)) return '—';
+  return d.toLocaleString(undefined, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit', ...(withSeconds ? { second: '2-digit' } : {}) });
+}
+function fmtTime(ts) { const d = parseTs(ts); return d && !isNaN(d) ? d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', second: '2-digit' }) : ''; }
+function fmtDay(ts) { const d = parseTs(ts); return d && !isNaN(d) ? d.toLocaleDateString(undefined, { weekday: 'short', month: 'short', day: 'numeric' }) : '—'; }
+function fmtRelative(ts) {
+  const d = parseTs(ts); if (!d || isNaN(d)) return 'never';
+  const diff = (Date.now() - d.getTime()) / 1000, fut = diff < 0, a = Math.abs(diff);
+  let out;
+  if (a < 45) out = 'just now';
+  else if (a < 3600) out = `${Math.round(a / 60)} min`;
+  else if (a < 86400) out = `${Math.round(a / 3600)} h`;
+  else out = `${Math.round(a / 86400)} d`;
+  if (out === 'just now') return out;
+  return fut ? `in ${out}` : `${out} ago`;
+}
+function todayStr(offsetDays = 0) {
+  const d = new Date(Date.now() + offsetDays * 86400000);
+  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
+}
+const triggerLabel = (t) => ({ manual: 'Manual', schedule: 'Scheduled', shortcut: 'Shortcut', startup: 'At startup', retry: 'Retry', live: 'Live capture' }[t] || t);
+const directionLabel = (d) => ({ AUTO: 'Auto (from machine key)', IN: 'Always IN', OUT: 'Always OUT', NONE: 'Not set (ERPNext decides)' }[d] || d);
+const REASONS = {
+  duplicate: 'Already in ERPNext',
+  unknown_employee: 'No employee with this ID',
+  inactive_employee: 'Employee inactive',
+  validation: 'Rejected by ERPNext',
+  future_time: 'Time in the future',
+  repeat: 'Repeated punch',
+  manual: 'Skipped by user',
+  network: 'ERPNext unreachable',
+  server: 'ERPNext server error',
+  rate_limit: 'Rate limited',
+  auth: 'API key rejected',
+  permission: 'No permission',
+  not_found_endpoint: 'API method not found',
+};
+const reasonLabel = (r) => REASONS[r] || r || '';
+
+const STATUS = {
+  success: ['success', 'checkCircle', 'Success'],
+  partial: ['warning', 'alert', 'Partial'],
+  failed: ['danger', 'xCircle', 'Failed'],
+  cancelled: ['', 'stop', 'Cancelled'],
+  running: ['primary', 'loader', 'Running'],
+  queued: ['', 'clock', 'Queued'],
+  connecting: ['primary', 'loader', 'Connecting'],
+  fetching: ['info', 'download', 'Reading'],
+  pushing: ['primary', 'send', 'Sending'],
+  clearing: ['warning', 'loader', 'Clearing'],
+  done: ['success', 'checkCircle', 'Done'],
+  // machines
+  online: ['success', 'wifi', 'Online'],
+  offline: ['danger', 'wifiOff', 'Offline'],
+  unknown: ['', 'help', 'Not checked'],
+  error: ['danger', 'alert', 'Error'],
+  // punches
+  pending: ['info', 'clock', 'Pending'],
+  retrying: ['warning', 'refresh', 'Retrying'],
+  synced: ['success', 'checkCircle', 'Synced'],
+  skipped: ['', 'skip', 'Skipped'],
+};
+function statusBadge(status, text) {
+  const [cls, ic, label] = STATUS[status] || ['', 'info', status];
+  const spin = ['loader'].includes(ic) ? 'spin' : '';
+  return `<span class="badge ${cls}">${icon(ic, spin)}${esc(text || label)}</span>`;
+}
+function punchBadge(p) {
+  if (p.sync_status === 'pending' && p.attempts > 0) return statusBadge('retrying', `Retry ${p.attempts}`);
+  if (p.sync_status === 'synced' && p.reason === 'duplicate') return statusBadge('synced', 'Already there');
+  return statusBadge(p.sync_status);
+}
+function levelBadge(level) { return `<span class="lv lv-${esc(level)}">${esc(level)}</span>`; }
+
+/* ---------- toasts ---------- */
+function toast(message, type = 'info', title = '', ms = 5000) {
+  const ic = { success: 'checkCircle', error: 'xCircle', warning: 'alert', info: 'info' }[type] || 'info';
+  const el = document.createElement('div');
+  el.className = `toast ${type}`;
+  el.innerHTML = `${icon(ic)}<div>${title ? `<div class="t">${esc(title)}</div>` : ''}<div>${esc(message)}</div></div><button class="x" aria-label="Close">&times;</button>`;
+  $('#toasts').appendChild(el);
+  const close = () => { el.style.opacity = '0'; el.style.transition = 'opacity .2s'; setTimeout(() => el.remove(), 200); };
+  el.querySelector('.x').onclick = close;
+  if (ms) setTimeout(close, type === 'error' ? ms * 2 : ms);
+}
+function toastError(e, title = 'Error') {
+  if (e && e.detail) { toast(e.message, 'error', title); return; }
+  toast(e && e.message ? e.message : String(e), 'error', title);
+}
+
+/* ---------- modals ---------- */
+function openModal({ title, body = '', foot = '', size = '', onClose, icon: ic } = {}) {
+  const root = $('#modal-root');
+  const wrap = document.createElement('div');
+  wrap.className = 'modal-backdrop';
+  wrap.innerHTML = `<div class="modal ${size}" role="dialog" aria-modal="true">
+      <div class="modal-head">${ic ? `<span class="stat-icon" style="width:34px;height:34px">${icon(ic)}</span>` : ''}<h2>${esc(title)}</h2><button class="icon-btn" data-close aria-label="Close">${icon('x')}</button></div>
+      <div class="modal-body">${body}</div>
+      ${foot ? `<div class="modal-foot">${foot}</div>` : ''}
+    </div>`;
+  const close = () => { wrap.remove(); document.removeEventListener('keydown', keyh); onClose && onClose(); };
+  const keyh = (e) => { if (e.key === 'Escape' && root.lastElementChild === wrap) close(); };
+  document.addEventListener('keydown', keyh);
+  wrap.addEventListener('mousedown', (e) => { if (e.target === wrap) wrap._down = true; });
+  wrap.addEventListener('mouseup', (e) => { if (e.target === wrap && wrap._down) close(); wrap._down = false; });
+  wrap.querySelectorAll('[data-close]').forEach((b) => (b.onclick = close));
+  root.appendChild(wrap);
+  const first = wrap.querySelector('input:not([type=hidden]):not([type=checkbox]):not([type=radio]), select, textarea');
+  if (first) setTimeout(() => first.focus(), 30);
+  return { el: wrap, body: wrap.querySelector('.modal-body'), close };
+}
+
+function confirmDialog({ title = 'Are you sure?', message = '', confirm = 'Confirm', danger = false } = {}) {
+  return new Promise((resolve) => {
+    let done = false;
+    const m = openModal({
+      title, icon: danger ? 'alert' : 'help',
+      body: `<p style="margin:0;color:var(--text-2)">${message}</p>`,
+      foot: `<button class="btn" data-close>Cancel</button><button class="btn ${danger ? 'btn-danger' : 'btn-primary'}" data-ok>${esc(confirm)}</button>`,
+      onClose: () => { if (!done) resolve(false); },
+    });
+    m.el.querySelector('[data-ok]').onclick = () => { done = true; m.close(); resolve(true); };
+  });
+}
+
+function promptDialog({ title, label, value = '', type = 'text', placeholder = '', hint = '', confirm = 'OK' }) {
+  return new Promise((resolve) => {
+    let done = false;
+    const m = openModal({
+      title,
+      body: `<div class="field"><label>${esc(label)}</label><input class="input" type="${type}" value="${esc(value)}" placeholder="${esc(placeholder)}">${hint ? `<div class="hint">${hint}</div>` : ''}</div>`,
+      foot: `<button class="btn" data-close>Cancel</button><button class="btn btn-primary" data-ok>${esc(confirm)}</button>`,
+      onClose: () => { if (!done) resolve(null); },
+    });
+    const inp = m.el.querySelector('input');
+    const ok = () => { done = true; const v = inp.value; m.close(); resolve(v); };
+    m.el.querySelector('[data-ok]').onclick = ok;
+    inp.addEventListener('keydown', (e) => { if (e.key === 'Enter') ok(); });
+  });
+}
+
+function errorDetailsDialog(title, message, detail) {
+  openModal({
+    title, icon: 'xCircle', size: 'wide',
+    body: `<div class="alert danger">${icon('xCircle')}<div>${esc(message)}</div></div>
+      ${detail ? `<h3 class="mt-3 mb-1">Technical details</h3><pre>${esc(detail)}</pre>` : ''}`,
+    foot: `${detail ? `<button class="btn" data-copy>${icon('copy')} Copy details</button>` : ''}<button class="btn btn-primary" data-close>Close</button>`,
+  }).el.querySelector('[data-copy]')?.addEventListener('click', () => {
+    navigator.clipboard?.writeText(`${message}\n\n${detail || ''}`).then(() => toast('Copied to clipboard', 'success'));
+  });
+}
+function showApiError(e, title = 'Error') {
+  if (e && e.detail) errorDetailsDialog(title, e.message, e.detail); else toastError(e, title);
+}
+
+/* ---------- live updates (WebSocket) ---------- */
+let ws = null, wsRetry = 1000;
+function connectWS() {
+  const proto = location.protocol === 'https:' ? 'wss' : 'ws';
+  ws = new WebSocket(`${proto}://${location.host}/ws`);
+  ws.onopen = () => { wsRetry = 1000; store.connected = true; emit('connection', true); };
+  ws.onclose = (e) => {
+    store.connected = false; emit('connection', false);
+    if (e.code === 4401) { showLogin(); return; }
+    setTimeout(connectWS, wsRetry); wsRetry = Math.min(wsRetry * 1.7, 15000);
+  };
+  ws.onmessage = (e) => {
+    let msg; try { msg = JSON.parse(e.data); } catch { return; }
+    handleMessage(msg);
+  };
+}
+
+function handleMessage(msg) {
+  switch (msg.type) {
+    case 'hello':
+      store.runs.clear();
+      (msg.runs || []).forEach((r) => store.runs.set(r.id, normalizeRun(r)));
+      emit('runs');
+      break;
+    case 'run_started':
+      store.runs.set(msg.run.id, normalizeRun(msg.run));
+      emit('runs'); emit('run_started', msg.run);
+      break;
+    case 'task': {
+      const t = msg.task, r = store.runs.get(t.run_id);
+      if (r) { const isNew = !r.tasks.has(t.id); r.tasks.set(t.id, t); emit(isNew ? 'runs' : 'task', t); }
+      break;
+    }
+    case 'run_cancelling': {
+      const r = store.runs.get(msg.run_id); if (r) { r.cancelling = true; emit('runs'); }
+      break;
+    }
+    case 'run_stage': {
+      const r = store.runs.get(msg.run_id); if (r) { r.stage = msg.stage; emit('run_meta', r); }
+      break;
+    }
+    case 'run_erp_blocked': {
+      const r = store.runs.get(msg.run_id); if (r) { r.erp_blocked = msg.reason; emit('run_meta', r); }
+      break;
+    }
+    case 'run_finished': {
+      const r = store.runs.get(msg.run_id);
+      if (r) { r.finished = msg.status; r.summary = msg.summary; }
+      emit('run_finished', msg);
+      const quiet = r && ['schedule', 'startup'].includes(r.trigger) && msg.status === 'success';
+      if (!quiet) {
+        const type = { success: 'success', partial: 'warning', cancelled: 'warning' }[msg.status] || 'error';
+        toast(msg.summary, type, 'Sync finished', 9000);
+      }
+      setTimeout(() => { store.runs.delete(msg.run_id); emit('runs'); }, 60000);
+      emit('runs');
+      break;
+    }
+    case 'device':
+      emit('device', msg.device);
+      break;
+    case 'punch':   // a punch received live from a machine
+      emit('punch', msg.punch);
+      break;
+    case 'live':    // live-capture status changed
+      store.live = msg.live;
+      emit('live', msg.live);
+      break;
+    case 'log':
+      emit('log', msg.log);
+      break;
+  }
+}
+function normalizeRun(r) {
+  return { ...r, tasks: new Map((r.tasks || []).map((t) => [t.id, t])) };
+}
+function activeRuns() { return [...store.runs.values()].filter((r) => !r.finished); }
+
+/* ---------- common UI bits ---------- */
+function emptyState(ic, title, text = '', action = '') {
+  return `<div class="empty">${icon(ic)}<div class="t">${esc(title)}</div><div>${text}</div>${action ? `<div class="mt-2">${action}</div>` : ''}</div>`;
+}
+function switchHtml(name, checked, label = '', sub = '') {
+  return `<label class="switch"><input type="checkbox" name="${esc(name)}" ${checked ? 'checked' : ''}><span class="track"></span>${label ? `<span class="txt"><span>${esc(label)}</span>${sub ? `<small>${esc(sub)}</small>` : ''}</span>` : ''}</label>`;
+}
+function setBusy(btn, busy, text) {
+  if (!btn) return;
+  if (busy) { btn._html = btn.innerHTML; btn.disabled = true; btn.innerHTML = `${icon('loader', 'spin')} ${esc(text || 'Working…')}`; }
+  else { btn.disabled = false; if (btn._html) btn.innerHTML = btn._html; }
+}
+function throttle(fn, ms) {
+  let t = 0, timer = null;
+  return (...a) => {
+    const now = Date.now();
+    if (now - t >= ms) { t = now; fn(...a); }
+    else if (!timer) timer = setTimeout(() => { timer = null; t = Date.now(); fn(...a); }, ms - (now - t));
+  };
+}
+const DAYS = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
+
+async function loadDevices() { store.devices = await api('/devices'); return store.devices; }
+async function loadSettings() { store.settings = await api('/settings'); return store.settings; }
+
+/* ---------- restart the service from the GUI ---------- */
+async function restartService() {
+  const ok = await confirmDialog({ title: 'Restart the service?', message: 'The attendance sync service stops for a few seconds and starts again. Live capture reconnects by itself. This page reloads when it is back.', confirm: 'Restart' });
+  if (!ok) return;
+  let before = null;
+  try { before = (await api('/health')).started_at; } catch (e) { /* ignore */ }
+  try { await api('/service/restart', { method: 'POST' }); } catch (e) { return toastError(e, 'Could not restart'); }
+  toast('Restarting the service…', 'info', '', 20000);
+  const t0 = Date.now();
+  const wait = async () => {
+    await new Promise((r) => setTimeout(r, 1500));
+    try {
+      const h = await api('/health');
+      if (h.started_at && h.started_at !== before) { location.reload(); return; }
+    } catch (e) { /* still down */ }
+    if (Date.now() - t0 < 60000) return wait();
+    toast('The service did not come back within a minute. Check that it is running.', 'danger', '', 15000);
+  };
+  wait();
+}
