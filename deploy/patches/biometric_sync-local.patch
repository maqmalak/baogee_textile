+.dx-av img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: var(--surface-3); }
+
+/* Urdu names from ERPNext: Nastaliq needs tall lines, or letters overlap the next line / the pill edge */
+.dx bdi.u { font-family: var(--font-ur); font-weight: 700; }
+.dx[lang="ur"] bdi.u { font-family: var(--font-ur); }
+.dx[lang="ur"] .dx-spot-name { line-height: 1.6; font-size: 48px; margin-top: 4px; }
+.dx[lang="ur"] .dx-tile b { font-size: 22px; line-height: 1.3; }
+.dx[lang="ur"] .dx-tile b:has(bdi.u) { font-size: 24px; line-height: 1.9; }
+.dx[lang="ur"] .dx-tl-txt .n, .dx[lang="ur"] .dx-tl-txt .m, .dx[lang="ur"] .dx-person-id .n, .dx[lang="ur"] .dx-person-id .m,
+.dx[lang="ur"] .dx-person-id .o, .dx[lang="ur"] .dx-list-who .n, .dx[lang="ur"] .dx-list-who .m, .dx[lang="ur"] .dx-list td.o { line-height: 1.95; }
+.dx[lang="ur"] .dx-tl-txt .n, .dx[lang="ur"] .dx-person-id .n, .dx[lang="ur"] .dx-list-who .n { font-size: 19px; }
+body.kiosk .dx[lang="ur"] .dx-spot-name { font-size: 64px; }
+
+/* Urdu pills and badges: room above and below the letters (fixes "روانگی" spilling out) */
+.dx[lang="ur"] .dx-spot-act { font-size: 28px; line-height: 1.5; padding: 4px 22px 10px; }
+.dx[lang="ur"] .dx-pill, .dx[lang="ur"] .dx-state, .dx[lang="ur"] .dx-sync, .dx[lang="ur"] .dx-chip,
+.dx[lang="ur"] .dx-spot-ago, .dx[lang="ur"] .dx-seg button { line-height: 1.9; padding-top: 2px; padding-bottom: 6px; }
+.dx[lang="ur"] .dx-fs { line-height: 1.8; }
+
+/* live capture: amber pulse while a machine is reconnecting */
+.dx.live-warn .dx-pulse { background: #fbbf24; animation: none; }
+.dx-title { font-size: 18px; font-weight: 800; letter-spacing: .01em; line-height: 1.2; }
+body.kiosk .dx-title { font-size: 22px; }
+.dx[lang="ur"] .dx-title { line-height: 1.6; }
+.dx-kpi-s.dx-unlinked { color: var(--warning); font-weight: 700; cursor: help; }
+.dx-period { display: flex; align-items: center; gap: 8px; margin: 2px 4px -8px; font-size: 15px; font-weight: 600; color: var(--text-2); }
+.dx-period svg { width: 16px; height: 16px; vertical-align: 0; color: var(--primary); }
+.dx-period b { color: var(--text); }
+.dx[lang="ur"] .dx-period { font-size: 18px; line-height: 1.9; }
+
+/* display: service status bar */
+.dx-status { display: flex; flex-wrap: wrap; gap: 8px; margin-top: -6px; }
+.dx-st { --c: var(--text-2); display: inline-flex; align-items: center; gap: 7px; font-size: 14px; font-weight: 700; padding: 6px 12px 6px 10px;
+  border-radius: 999px; background: color-mix(in srgb, var(--c) 10%, var(--surface)); color: var(--c);
+  border: 1px solid color-mix(in srgb, var(--c) 28%, transparent); white-space: nowrap; }
+.dx-st svg { width: 15px; height: 15px; vertical-align: 0; }
+.dx-st.ok { --c: var(--success); } .dx-st.warn { --c: var(--warning); } .dx-st.bad { --c: var(--danger); }
+.dx-st.info { --c: var(--primary); } .dx-st.off { --c: var(--text-2); }
+.dx-st.bad:first-child { animation: dx-blink 1.4s ease-in-out infinite; }
+@keyframes dx-blink { 50% { opacity: .55; } }
+.dx[lang="ur"] .dx-st { font-size: 16px; line-height: 1.8; padding-top: 2px; padding-bottom: 6px; }
+@media (max-width: 640px) { .dx-st { font-size: 12.5px; } }
