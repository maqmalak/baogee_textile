+.task .msg .details { color: var(--muted); }
+.stage .label { display: flex; justify-content: space-between; gap: 8px; font-size: 12px; color: var(--text-2); margin-bottom: 5px; font-weight: 550; }
+.stage .label .r { color: var(--muted); font-weight: 500; font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.bar { position: relative; height: 9px; border-radius: 999px; background: var(--surface-3); overflow: hidden; }
+.bar > span { position: absolute; inset: 0 auto 0 0; width: 0; background: var(--primary); border-radius: inherit; transition: width .35s ease; }
+.bar.done > span { background: var(--success); width: 100% !important; }
+.bar.failed > span { background: var(--danger); }
+.bar.indeterminate > span {
+  width: 35% !important; animation: indeterminate 1.4s ease-in-out infinite;
+  background: linear-gradient(90deg, transparent, var(--primary), transparent);
+}
+.bar.striped > span {
+  background-image: linear-gradient(45deg, rgba(255,255,255,.22) 25%, transparent 25%, transparent 50%, rgba(255,255,255,.22) 50%, rgba(255,255,255,.22) 75%, transparent 75%);
+  background-size: 18px 18px; animation: stripes .8s linear infinite;
+}
+@keyframes indeterminate { 0% { left: -35% } 100% { left: 100% } }
+@keyframes stripes { to { background-position: 18px 0 } }
+.bar-lg { height: 12px; }
+.spin { animation: spin 1s linear infinite; }
+@keyframes spin { to { transform: rotate(360deg) } }
+.st-success { color: var(--success); } .st-failed { color: var(--danger); } .st-cancelled { color: var(--muted); }
+.st-creating, .st-copying, .st-running { color: var(--primary); } .st-queued { color: var(--muted); }
+
+.live-log { max-height: 280px; overflow: auto; font-family: var(--mono); font-size: 12px; padding: 10px 14px; background: var(--surface-2); }
+.live-log .l { padding: 2px 0; display: flex; gap: 10px; }
+.live-log .l .ts { color: var(--muted); flex-shrink: 0; }
+.lv { font-weight: 700; font-size: 10.5px; padding: 1px 7px; border-radius: 5px; letter-spacing: .03em; flex-shrink: 0; line-height: 16px; height: 18px; }
+.lv-ERROR { background: var(--danger-soft); color: var(--danger); }
+.lv-WARNING { background: var(--warning-soft); color: var(--warning); }
+.lv-SUCCESS { background: var(--success-soft); color: var(--success); }
+.lv-INFO { background: var(--info-soft); color: var(--info); }
+
+/* ---------- logs page ---------- */
+.filters { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; padding: 14px 20px; border-bottom: 1px solid var(--border); }
+.filters .input { width: auto; }
+.level-chips { display: flex; gap: 6px; flex-wrap: wrap; }
+.level-chips button { border: 1px solid var(--border-strong); background: var(--surface); border-radius: 999px; padding: 4px 12px; font: inherit; font-size: 12px; font-weight: 600; cursor: pointer; color: var(--text-2); }
+.level-chips button.active.ERROR { background: var(--danger-soft); color: var(--danger); border-color: var(--danger); }
+.level-chips button.active.WARNING { background: var(--warning-soft); color: var(--warning); border-color: var(--warning); }
+.level-chips button.active.SUCCESS { background: var(--success-soft); color: var(--success); border-color: var(--success); }
+.level-chips button.active.INFO { background: var(--info-soft); color: var(--info); border-color: var(--info); }
+.log-msg { word-break: break-word; }
+tr.new-log td { animation: flash 1.2s ease-out; }
+@keyframes flash { from { background: var(--primary-soft) } to { background: transparent } }
+
+/* ---------- alerts ---------- */
+.alert { display: flex; gap: 12px; padding: 12px 16px; border-radius: 10px; border: 1px solid; font-size: 13px; align-items: flex-start; }
+.alert svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }
+.alert.info { background: var(--info-soft); border-color: color-mix(in srgb, var(--info) 30%, transparent); color: var(--text); }
+.alert.info svg { color: var(--info); }
+.alert.warning { background: var(--warning-soft); border-color: color-mix(in srgb, var(--warning) 35%, transparent); }
+.alert.warning svg { color: var(--warning); }
+.alert.danger { background: var(--danger-soft); border-color: color-mix(in srgb, var(--danger) 35%, transparent); }
+.alert.danger svg { color: var(--danger); }
+.alert.success { background: var(--success-soft); border-color: color-mix(in srgb, var(--success) 35%, transparent); }
+.alert.success svg { color: var(--success); }
+.alert .t { font-weight: 600; }
+
+/* ---------- modal ---------- */
+.modal-backdrop { position: fixed; inset: 0; background: rgba(15, 23, 42, .5); backdrop-filter: blur(2px); display: grid; place-items: center; z-index: 100; padding: 20px; animation: fade .15s; }
+.modal { background: var(--surface); border-radius: 14px; box-shadow: var(--shadow-lg); width: min(640px, 100%); max-height: calc(100vh - 40px); display: flex; flex-direction: column; animation: pop .18s ease-out; border: 1px solid var(--border); }
+.modal.wide { width: min(920px, 100%); }
+.modal.xwide { width: min(1100px, 100%); }
+.modal-head { display: flex; align-items: center; gap: 12px; padding: 18px 22px; border-bottom: 1px solid var(--border); }
+.modal-head h2 { flex: 1; }
+.modal-body { padding: 20px 22px; overflow: auto; }
+.modal-foot { display: flex; justify-content: flex-end; gap: 10px; padding: 14px 22px; border-top: 1px solid var(--border); background: var(--surface-2); border-radius: 0 0 14px 14px; flex-wrap: wrap; }
+@keyframes fade { from { opacity: 0 } }
+@keyframes pop { from { opacity: 0; transform: translateY(8px) scale(.98) } }
+
+.tabs { display: flex; gap: 2px; border-bottom: 1px solid var(--border); margin: -6px 0 18px; overflow-x: auto; }
+.tabs button { border: 0; background: transparent; padding: 10px 14px; font: inherit; font-weight: 550; color: var(--muted); cursor: pointer; border-bottom: 2px solid transparent; margin-bottom: -1px; white-space: nowrap; display: inline-flex; gap: 6px; align-items: center; }
+.tabs button svg { width: 15px; height: 15px; }
+.tabs button.active { color: var(--primary); border-bottom-color: var(--primary); }
+.tabs button:hover { color: var(--text); }
+
+/* folder picker */
+.fp-path { font-family: var(--mono); font-size: 12.5px; background: var(--surface-3); padding: 8px 12px; border-radius: 8px; word-break: break-all; }
+.fp-list { border: 1px solid var(--border); border-radius: 10px; max-height: 340px; overflow: auto; margin-top: 10px; }
+.fp-list button { display: flex; width: 100%; align-items: center; gap: 10px; padding: 9px 14px; border: 0; background: transparent; font: inherit; color: var(--text); cursor: pointer; text-align: left; border-bottom: 1px solid var(--border); }
+.fp-list button:last-child { border-bottom: 0; }
+.fp-list button:hover { background: var(--surface-2); }
+.fp-list svg { width: 17px; height: 17px; color: var(--warning); flex-shrink: 0; }
+
+/* tree in start dialog */
+.tree { border: 1px solid var(--border); border-radius: 10px; max-height: 380px; overflow: auto; }
+.tree-server { border-bottom: 1px solid var(--border); }
+.tree-server:last-child { border-bottom: 0; }
+.tree-row { display: flex; align-items: center; gap: 10px; padding: 9px 14px; }
+.tree-row.srv { background: var(--surface-2); font-weight: 600; }
+.tree-row.site { padding-left: 40px; }
+.tree-row input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--primary); }
+.tree-row .n { flex: 1; min-width: 0; }
+.tree-row select { height: 30px; font-size: 12.5px; width: 150px; padding: 0 8px; }
+
+/* toasts */
+#toasts { position: fixed; right: 20px; bottom: 20px; display: flex; flex-direction: column; gap: 10px; z-index: 200; max-width: min(420px, calc(100vw - 40px)); }
+.toast { display: flex; gap: 12px; align-items: flex-start; background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--primary); border-radius: 10px; padding: 12px 14px; box-shadow: var(--shadow-lg); animation: pop .2s ease-out; font-size: 13px; }
+.toast svg { width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px; }
+.toast.success { border-left-color: var(--success); } .toast.success svg { color: var(--success); }
+.toast.error { border-left-color: var(--danger); } .toast.error svg { color: var(--danger); }
+.toast.warning { border-left-color: var(--warning); } .toast.warning svg { color: var(--warning); }
+.toast.info svg { color: var(--primary); }
+.toast .t { font-weight: 600; }
+.toast .x { margin-left: auto; border: 0; background: transparent; color: var(--muted); cursor: pointer; padding: 0 2px; font-size: 18px; line-height: 1; }
+
+/* charts */
+.chart-box { position: relative; height: 260px; }
+.chart-box.sm { height: 200px; }
+
+/* help */
+.help { display: grid; grid-template-columns: 230px minmax(0, 1fr); gap: 24px; align-items: start; }
+.help-toc { position: sticky; top: 84px; padding: 12px; }
+.help-toc a { display: block; padding: 6px 10px; border-radius: 7px; color: var(--text-2); font-size: 13px; text-decoration: none; }
+.help-toc a:hover { background: var(--surface-3); color: var(--text); }
+.help-content { padding: 8px 32px 32px; }
+.help-content section { padding-top: 22px; scroll-margin-top: 80px; }
+.help-content h2 { font-size: 19px; margin: 6px 0 10px; padding-bottom: 8px; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: 10px; }
+.help-content h2 svg { width: 20px; height: 20px; color: var(--primary); }
+.help-content h3 { margin: 18px 0 6px; }
+.help-content p, .help-content li { color: var(--text-2); }
+.help-content li { margin: 4px 0; }
+.help-content ol, .help-content ul { padding-left: 22px; }
+.help-content table { margin: 10px 0; }
+.help-content kbd { font-family: var(--mono); font-size: 11.5px; background: var(--surface-3); border: 1px solid var(--border-strong); border-bottom-width: 2px; padding: 1px 6px; border-radius: 5px; }
+.steps { counter-reset: s; list-style: none; padding-left: 0 !important; }
+.steps > li { counter-increment: s; position: relative; padding-left: 40px; margin: 12px 0 !important; }
+.steps > li::before { content: counter(s); position: absolute; left: 0; top: -1px; width: 26px; height: 26px; border-radius: 50%; background: var(--primary-soft); color: var(--primary); font-weight: 700; display: grid; place-items: center; font-size: 13px; }
+
+/* login */
+.login-wrap { min-height: 100vh; display: grid; place-items: center; padding: 20px; background: radial-gradient(circle at 20% 10%, color-mix(in srgb, var(--primary) 18%, transparent), transparent 40%), var(--bg); }
+.login-card { width: min(380px, 100%); padding: 32px; }
+.login-card .brand { color: var(--text); padding: 0 0 22px; }
+.login-card .brand-sub { color: var(--muted); }
+
+/* ---------- responsive ---------- */
+@media (max-width: 1200px) {
+  .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .task { grid-template-columns: minmax(160px, 1fr) minmax(180px, 1.4fr) minmax(180px, 1.4fr) 96px; gap: 14px; }
+}
+@media (max-width: 980px) {
+  .sidebar { position: fixed; left: 0; top: 0; transform: translateX(-100%); transition: transform .2s; box-shadow: var(--shadow-lg); }
+  .sidebar.open { transform: translateX(0); }
+  .topbar .menu-btn { display: inline-grid; }
+  .grid-3, .grid-2 { grid-template-columns: minmax(0, 1fr); }
+  .help { grid-template-columns: minmax(0, 1fr); }
+  .help-toc { position: static; }
+  .task { grid-template-columns: minmax(0, 1fr) auto; }
+  .task .stage { grid-column: 1 / -1; }
+  .task .task-actions { grid-row: 1; grid-column: 2; }
+}
+@media (max-width: 640px) {
+  .grid-4 { grid-template-columns: minmax(0, 1fr); }
+  .view { padding: 16px 16px 40px; }
+  .topbar { padding: 12px 16px; }
+  .topbar .status-pill { display: none; }
+  .form-grid { grid-template-columns: minmax(0, 1fr); }
+  .help-content { padding: 8px 18px 24px; }
+  .card-head, .card-body { padding-left: 16px; padding-right: 16px; }
+  .tree-row.site { padding-left: 24px; flex-wrap: wrap; }
+  .tree-row select { width: 100%; }
+  .modal-backdrop { padding: 8px; }
+}
+@media (prefers-reduced-motion: reduce) { * { animation-duration: .01ms !important; transition-duration: .01ms !important; } }
+.task .task-actions { text-align: right; }
+
+/* ---------- Attendance Sync additions ---------- */
+.nav-count { margin-left: auto; background: var(--danger); color: #fff; font-size: 10.5px; font-weight: 700; border-radius: 999px; padding: 1px 7px; line-height: 16px; }
+.status-chips { display: flex; gap: 8px; flex-wrap: wrap; }
+.status-chips button { display: inline-flex; align-items: center; gap: 6px; border: 1px solid var(--border); background: var(--surface); color: var(--text-2); border-radius: 999px; padding: 5px 12px; font: inherit; font-size: 12.5px; font-weight: 550; cursor: pointer; }
+.status-chips button .n { font-variant-numeric: tabular-nums; color: var(--muted); font-weight: 600; }
+.status-chips button.active { border-color: var(--primary); background: var(--primary-soft); color: var(--primary); }
+.status-chips button.active .n { color: var(--primary); }
+.status-chips button svg { width: 14px; height: 14px; }
+.kv { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: 6px 16px; font-size: 13px; }
+.kv > div:nth-child(odd) { color: var(--muted); }
+.device-card .server-head { align-items: flex-start; }
+.device-kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--border); }
+.device-kpis > div { padding: 10px 20px; border-right: 1px solid var(--border); }
+.device-kpis > div:last-child { border-right: 0; }
+.device-kpis .l { font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; font-weight: 600; }
+.device-kpis .v { font-size: 17px; font-weight: 700; font-variant-numeric: tabular-nums; margin-top: 2px; }
+.device-kpis .v small { font-size: 12px; font-weight: 500; color: var(--muted); }
+.task.dev { grid-template-columns: minmax(180px, 1.1fr) minmax(200px, 1.5fr) minmax(200px, 1.5fr) 110px; }
+.counts { display: flex; gap: 10px; flex-wrap: wrap; font-size: 12px; color: var(--text-2); margin-top: 6px; }
+.counts span { display: inline-flex; align-items: center; gap: 4px; }
+.counts svg { width: 13px; height: 13px; }
+.table td.cb, .table th.cb { width: 34px; padding-right: 0; }
+.issue-row td:first-child { box-shadow: inset 3px 0 0 var(--warning); }
+.issue-row.bad td:first-child { box-shadow: inset 3px 0 0 var(--danger); }
+.health-row { display: flex; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px dashed var(--border); }
+.health-row:last-child { border-bottom: 0; }
+.health-row .stat-icon { width: 34px; height: 34px; }
+.health-row .t { font-weight: 600; }
+.health-row .d { font-size: 12.5px; color: var(--muted); }
+.mapping-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }
+.pager { display: flex; gap: 8px; align-items: center; padding: 12px 20px; border-top: 1px solid var(--border); flex-wrap: wrap; }
+.scan-list { max-height: 320px; overflow: auto; border: 1px solid var(--border); border-radius: var(--radius-sm); }
+.scan-list .row { padding: 8px 12px; border-bottom: 1px solid var(--border); }
+.scan-list .row:last-child { border-bottom: 0; }
+.shift-map { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 12px; background: var(--surface-2); }
+.shift-map + .shift-map { margin-top: 10px; }
+.check-list { display: flex; flex-wrap: wrap; gap: 6px 14px; }
+.check-list label { display: inline-flex; gap: 6px; align-items: center; font-size: 13px; cursor: pointer; }
+@media (max-width: 980px) {
+  .device-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
+  .device-kpis > div { border-bottom: 1px solid var(--border); }
+  .task.dev { grid-template-columns: minmax(0, 1fr) auto; }
+}
+
+/* ---------- Check-in Display (modern board) ---------- */
+.dx {
+  --dx-in: #10b981; --dx-out: #f97316; --dx-amber: #f59e0b; --dx-red: #ef4444; --dx-violet: #8b5cf6; --dx-blue: #3b82f6;
+  --dx-card: var(--surface); --dx-line: var(--border); --dx-r: 18px;
+  display: flex; flex-direction: column; gap: 18px; font-variant-numeric: tabular-nums;
+}
+.dx svg { vertical-align: -3px; }
+
+/* header band (compact, one row) */
+.dx-hero {
+  position: relative; overflow: hidden; border-radius: 16px; padding: 10px 12px 10px 20px; color: #fff;
+  display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
+  background: linear-gradient(100deg, #312e81 0%, #4338ca 45%, #0369a1 100%);
+  box-shadow: 0 10px 24px -14px rgba(79, 70, 229, .6);
+}
+.dx-hero-l { flex: 1; min-width: 160px; display: flex; flex-direction: column; gap: 3px; }
+.dx-hero-r { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
+.dx-clock { font-size: 44px; font-weight: 800; letter-spacing: -.03em; line-height: 1; white-space: nowrap; }
+.dx-clock .s { font-size: .45em; font-weight: 700; opacity: .85; margin-left: 4px; letter-spacing: 0; }
+.dx-clock .ap { font-size: .38em; font-weight: 800; opacity: 1; margin-left: 6px; letter-spacing: .04em; }
+.dx-date { font-size: 17px; font-weight: 700; }
+.dx-live { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; }
+.dx-pulse { width: 7px; height: 7px; border-radius: 50%; background: #34d399; box-shadow: 0 0 0 0 rgba(52,211,153,.7); animation: dx-pulse 1.8s infinite; }
+.dx.past .dx-pulse { background: #fbbf24; animation: none; }
+@keyframes dx-pulse { 70% { box-shadow: 0 0 0 9px rgba(52,211,153,0); } 100% { box-shadow: 0 0 0 0 rgba(52,211,153,0); } }
+.dx-ctrl { display: flex; align-items: center; gap: 2px; padding: 3px; border-radius: 11px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.16); }
+.dx-ctrl select, .dx-ctrl input, .dx-ctrl button { appearance: none; border: 0; background: transparent; color: #fff; font: inherit; font-size: 15px; font-weight: 600; padding: 8px 10px; border-radius: 8px; cursor: pointer; color-scheme: dark; }
+.dx-ctrl select { padding-right: 22px; background-image: linear-gradient(45deg, transparent 50%, #fff 50%), linear-gradient(135deg, #fff 50%, transparent 50%);
+  background-position: calc(100% - 12px) 52%, calc(100% - 7px) 52%; background-size: 5px 5px; background-repeat: no-repeat; max-width: 170px; }
+.dx-ctrl select option { color: #111; }
+.dx-ctrl > *:hover { background-color: rgba(255,255,255,.14); }
+.dx-ctrl button { display: grid; place-items: center; padding: 6px; }
+.dx-ctrl button.spinning svg { animation: spin .8s linear infinite; }
+.dx-theme { display: grid; place-items: center; width: 42px; height: 42px; cursor: pointer; color: #fff; border-radius: 11px;
+  background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18); transition: background .15s; }
+.dx-theme:hover { background: rgba(255,255,255,.24); }
+.dx-theme svg { width: 16px; height: 16px; vertical-align: 0; }
+.dx-fs { display: inline-flex; align-items: center; gap: 7px; height: 42px; border: 0; cursor: pointer; font: inherit; font-weight: 700; font-size: 15px;
+  padding: 0 14px; border-radius: 11px; background: #fff; color: #312e81; transition: transform .15s; }
+.dx-fs:hover { transform: translateY(-1px); }
+
+/* KPIs */
+.dx-kpis { display: grid; gap: 14px; grid-template-columns: 1.5fr repeat(4, minmax(0, 1fr)); }
+.dx-kpi { position: relative; overflow: hidden; background: var(--dx-card); border: 1px solid var(--dx-line); border-radius: var(--dx-r); padding: 18px; box-shadow: var(--shadow-sm); --c: var(--dx-blue); }
+.dx-kpi::before { content: ""; position: absolute; right: -30px; top: -30px; width: 110px; height: 110px; border-radius: 50%; background: var(--c); opacity: .08; }
+.dx-kpi.green { --c: var(--dx-in); } .dx-kpi.blue { --c: var(--dx-out); } .dx-kpi.amber { --c: var(--dx-amber); } .dx-kpi.red { --c: var(--dx-red); } .dx-kpi.violet { --c: var(--dx-violet); }
+.dx-kpi-ic { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; color: var(--c); background: color-mix(in srgb, var(--c) 14%, transparent); }
+.dx-kpi-ic svg { width: 22px; height: 22px; vertical-align: 0; }
+.dx-kpi-v { font-size: 44px; font-weight: 800; letter-spacing: -.02em; line-height: 1.1; margin-top: 12px; }
+.dx-kpi-v.sm { font-size: 38px; margin-top: 2px; }
+.dx-kpi-v small { font-size: 20px; font-weight: 700; color: var(--text-2); }
+.dx-kpi-l { font-size: 17px; font-weight: 800; color: var(--text); }
+.dx-kpi-s { font-size: 14px; font-weight: 600; color: var(--text-2); margin-top: 2px; }
+.dx-rate { display: flex; align-items: center; gap: 18px; --c: var(--dx-in); }
+.dx-ring { --p: 0; width: 100px; height: 100px; flex-shrink: 0; border-radius: 50%; display: grid; place-items: center;
+  background: conic-gradient(var(--dx-in) calc(var(--p) * 1%), color-mix(in srgb, var(--dx-in) 14%, var(--surface-3)) 0); transition: --p .6s; }
+.dx-ring span { width: 76px; height: 76px; border-radius: 50%; background: var(--dx-card); display: grid; place-items: center; font-size: 24px; font-weight: 800; }
+
+/* layout */
+/* Activity and Employees share one height and scroll inside */
+.dx-main { --dx-panel-h: 640px; display: grid; gap: 18px; grid-template-columns: minmax(0, 5fr) minmax(0, 8fr); align-items: stretch; }
+.dx-main > .dx-col > .dx-card, .dx-main > .dx-board { height: var(--dx-panel-h); display: flex; flex-direction: column; }
+.dx-col { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
+.dx-card { background: var(--dx-card); border: 1px solid var(--dx-line); border-radius: var(--dx-r); box-shadow: var(--shadow-sm); min-width: 0; }
+.dx-card-h { display: flex; align-items: center; gap: 12px; padding: 16px 18px; flex-wrap: wrap; border-bottom: 1px solid var(--dx-line); }
+.dx-card-h h3 { flex: 1; display: flex; align-items: center; gap: 10px; font-size: 20px; font-weight: 800; min-width: 110px; }
+.dx-card-h h3 svg { color: var(--primary); }
