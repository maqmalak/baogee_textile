+/* Details of one sync run (Biometric Sync Log). */
+import { useEffect, useState } from "react";
+import { useNavigate } from "react-router-dom";
+import { get } from "../lib/api";
+import { fmtDate, fmtDuration, fmtNum, triggerLabel } from "../lib/format";
+import { Icon, Loading, Modal, StatusBadge, toastError } from "../lib/ui";
+
+export function RunDialog({ id, onClose }: { id: string; onClose: () => void }) {
+  const nav = useNavigate();
+  const [d, setD] = useState<any>(null);
+  useEffect(() => { get("run", { name: id }).then(setD).catch((e) => { toastError(e); onClose(); }); }, [id, onClose]);
+  const r = d?.run;
+  return (
+    <Modal title={`Sync run ${id}`} icon="history" size="xwide" onClose={onClose}
+      foot={<>
+        <a className="btn" href={`/app/biometric-sync-log/${encodeURIComponent(id)}`} target="_blank" rel="noreferrer"><Icon name="external" /> Open in desk</a>
+        <button className="btn" onClick={() => { onClose(); nav(`/punches/run/${encodeURIComponent(id)}`); }}><Icon name="list" /> Punches of this run</button>
+        <button className="btn btn-primary" onClick={onClose}>Close</button></>}>
+      {!r ? <Loading /> : <>
+        <div className="row mb-3" style={{ gap: 18 }}>
+          <StatusBadge status={r.status} />
+          <span className="small"><Icon name="clock" /> {fmtDate(r.started_at, true)} → {r.finished_at ? fmtDate(r.finished_at, true) : "running"}</span>
+          <span className="small">{triggerLabel(r.trigger)}</span>
+          <span className="small"><b>{r.device_name}</b></span>
+        </div>
+        <div className="grid grid-4 mb-3">
+          {[["Read from machine", r.fetched], ["New punches", r.new_punches], ["Check-ins created", r.pushed], ["Duplicates", r.duplicates],
+            ["Unmatched (no employee)", r.unmatched], ["Double punches", r.double_punches], ["Skipped / out of range", r.skipped], ["Failed", r.failed]].map(([l, v]) => (
+            <div key={l as string} className="card" style={{ padding: "12px 16px" }}><div className="label muted small">{l}</div><div style={{ fontSize: 22, fontWeight: 700 }} className={l === "Failed" && v ? "st-failed" : ""}>{fmtNum(v)}</div></div>
+          ))}
+        </div>
+        <div className="kv mb-3">
+          <div>Duration</div><div>{fmtDuration(r.duration)}</div>
+          <div>Window read</div><div>{r.from_date ? fmtDate(r.from_date) : "—"} → {r.to_date ? fmtDate(r.to_date) : "now"}</div>
+          <div>Punch status now</div><div>{Object.entries(d.breakdown || {}).map(([k, v]) => `${k}: ${fmtNum(v)}`).join(" · ") || "—"}</div>
+        </div>
+        {r.summary && <><h3 className="mb-1">Message</h3><pre className="live-log" style={{ maxHeight: 280, borderRadius: 10, whiteSpace: "pre-wrap" }}>{r.summary}</pre></>}
+      </>}
+    </Modal>
+  );
+}
diff --git a/frontend/src/components/SyncDialog.tsx b/frontend/src/components/SyncDialog.tsx
new file mode 100644
index 0000000..4e7ac47
--- /dev/null
+++ b/frontend/src/components/SyncDialog.tsx
@@ -0,0 +1,87 @@
+/* "Sync attendance": read machines now (optionally a date range), or only reprocess waiting punches. */
+import { useEffect, useState } from "react";
+import { useNavigate } from "react-router-dom";
+import { get, post } from "../lib/api";
+import { fmtNum } from "../lib/format";
+import { useStore } from "../lib/store";
+import { PULL, type Device } from "../lib/types";
+import { Icon, Loading, Modal, StatusBadge, toast, toastError } from "../lib/ui";
+
+export type SyncPreset = { deviceIds?: string[]; resync?: boolean; from?: string; to?: string };
+
+export function SyncDialog({ preset = {}, onClose }: { preset?: SyncPreset; onClose: () => void }) {
+  const nav = useNavigate();
+  const { refreshActive } = useStore();
+  const [devices, setDevices] = useState<Device[] | null>(null);
+  const [mode, setMode] = useState<"full" | "push">("full");
+  const [sel, setSel] = useState<Set<string>>(new Set());
+  const [from, setFrom] = useState(preset.from || "");
+  const [to, setTo] = useState(preset.to || "");
+  const [busy, setBusy] = useState(false);
+
+  useEffect(() => {
+    get<Device[]>("devices").then((d) => {
+      const pull = d.filter((x) => PULL.includes(x.protocol));
+      setDevices(pull);
+      setSel(new Set(preset.deviceIds || pull.filter((x) => x.enabled).map((x) => x.id)));
+    }).catch(toastError);
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const pending = (devices || []).reduce((a, d) => a + d.stats.pending + d.stats.failed, 0);
+  const go = async () => {
+    if (mode === "full" && !sel.size) return toast("Select at least one machine.", "warning");
+    setBusy(true);
+    try {
+      if (mode === "push") {
+        const r = await post("start_sync", { push_only: 1 });
+        toast(`${fmtNum(r.reprocess?.count || 0)} waiting punch(es) are being processed.`, "success");
+      } else {
+        const r = await post("start_sync", { devices: [...sel], from_date: from ? `${from} 00:00:00` : null, to_date: to ? `${to} 23:59:59` : null });
+        toast(r.busy?.length ? `Started. Already running: ${r.busy.join(", ")}` : "The sync has started.", "success");
+      }
+      onClose();
+      await refreshActive();
+      nav("/progress");
+    } catch (e) { toastError(e, "Could not start the sync"); setBusy(false); }
+  };
+
+  return (
+    <Modal title="Sync attendance" icon="refresh" size="wide" onClose={onClose}
+      foot={<><button className="btn" onClick={onClose}>Cancel</button>
+        <button className="btn btn-primary" disabled={busy} onClick={go}>{busy ? <><Icon name="loader" className="spin" /> Starting…</> : <><Icon name="refresh" /> Start sync</>}</button></>}>
+      {!devices ? <Loading /> : !devices.length ? (
+        <div className="alert info"><Icon name="info" /><div>Add a biometric machine first (Machines → Add machine).</div></div>
+      ) : <>
+        <div className="field mb-3"><label>What to do</label>
+          <div className="radio-cards">
+            <label className={`radio-card ${mode === "full" ? "active" : ""}`}><input type="radio" checked={mode === "full"} onChange={() => setMode("full")} />
+              <div><div className="t"><Icon name="download" /> Read machines &amp; create check-ins</div><div className="d">Reads new punches from the selected machines, stores them as Biometric Logs and creates the Employee Checkins.</div></div></label>
+            <label className={`radio-card ${mode === "push" ? "active" : ""}`}><input type="radio" checked={mode === "push"} onChange={() => setMode("push")} />
+              <div><div className="t"><Icon name="send" /> Only process waiting punches</div><div className="d">Does not contact the machines. Matches the {fmtNum(pending)} waiting or failed punch(es) to employees again.</div></div></label>
+          </div>
+        </div>
+        {mode === "full" && <>
+          <div className="row mb-1"><span className="label">Machines</span><span className="spacer" />
+            <button className="btn btn-sm btn-ghost" onClick={() => setSel(new Set(devices.map((d) => d.id)))}>Select all</button>
+            <button className="btn btn-sm btn-ghost" onClick={() => setSel(new Set())}>Select none</button></div>
+          <div className="tree">{devices.map((d) => (
+            <label key={d.id} className="tree-row srv" style={{ cursor: "pointer" }}>
+              <input type="checkbox" checked={sel.has(d.id)} onChange={(e) => { const n = new Set(sel); e.target.checked ? n.add(d.id) : n.delete(d.id); setSel(n); }} />
+              <span className="n truncate"><Icon name="fingerprint" /> {d.name} <span className="muted small">{d.ip}</span> {!d.enabled && <span className="badge outline">disabled</span>}</span>
+              <span className="small"><StatusBadge status={d.status} />{d.stats.pending ? <> <span className="badge info">{fmtNum(d.stats.pending)} pending</span></> : null}</span>
+            </label>))}
+          </div>
+          <details className="mt-3" open={preset.resync}>
+            <summary className="strong small" style={{ cursor: "pointer" }}><Icon name="history" /> Read a date range again (advanced)</summary>
+            <div className="hint mt-1">Reads the punches of this period from the machines again, e.g. after check-ins were deleted. Punches already stored are recognised as duplicates, so nothing is created twice. Empty = since the last sync.</div>
+            <div className="form-grid mt-2">
+              <div className="field"><label>From</label><input className="input" type="date" value={from} onChange={(e) => setFrom(e.target.value)} /></div>
+              <div className="field"><label>To</label><input className="input" type="date" value={to} onChange={(e) => setTo(e.target.value)} /></div>
+            </div>
+          </details>
+        </>}
+      </>}
+    </Modal>
+  );
+}
diff --git a/frontend/src/lib/api.ts b/frontend/src/lib/api.ts
new file mode 100644
index 0000000..d8173ee
--- /dev/null
+++ b/frontend/src/lib/api.ts
@@ -0,0 +1,103 @@
+/* Calls biometric_sync.console_api on the Frappe site (same origin; the dev server proxies /api). */
+
+export class ApiError extends Error {
+  status: number;
+  detail?: string;
+  /** Settings are protected by the settings password and this session hasn't entered it. */
+  locked?: boolean;
+  constructor(message: string, status: number, detail?: string) {
+    super(message);
+    this.status = status;
+    this.detail = detail;
+  }
+}
+
+const M = "biometric_sync.console_api.";
+let csrf: string | null = null;
+
+async function csrfToken(): Promise<string> {
+  if (csrf) return csrf;
+  const r = await fetch(`/api/method/${M}csrf`, { credentials: "same-origin" });
+  const d = await r.json().catch(() => ({}));
+  csrf = d.message || "";
+  return csrf as string;
+}
+
+function errorText(d: any, res: Response): string {
+  try {
+    if (d?._server_messages) {
+      const msgs = JSON.parse(d._server_messages).map((m: string) => {
+        try { return JSON.parse(m).message; } catch { return m; }
+      });
+      return msgs.join(" ").replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
+    }
+  } catch { /* ignore */ }
+  if (d?.exception) return String(d.exception).split(":").slice(1).join(":").trim() || d.exception;
+  return res.statusText || "Request failed";
+}
+
+/** GET (reads) or POST (changes) a console_api method; returns `message`. */
+export async function call<T = any>(method: string, args: Record<string, any> = {}, post = false): Promise<T> {
+  const url = `/api/method/${M}${method}`;
+  let res: Response;
+  try {
+    if (post) {
+      const body = Object.fromEntries(Object.entries(args).map(([k, v]) => [k, v !== null && typeof v === "object" ? JSON.stringify(v) : v]));
+      res = await fetch(url, {
+        method: "POST", credentials: "same-origin",
+        headers: { "Content-Type": "application/json", Accept: "application/json", "X-Frappe-CSRF-Token": await csrfToken() },
+        body: JSON.stringify(body),
+      });
+    } else {
+      const qs = new URLSearchParams();
+      Object.entries(args).forEach(([k, v]) => { if (v !== undefined && v !== null && v !== "") qs.set(k, String(v)); });
+      res = await fetch(url + (qs.toString() ? "?" + qs : ""), { credentials: "same-origin", headers: { Accept: "application/json" } });
+    }
+  } catch {
+    throw new ApiError("Cannot reach the server.", 0);
+  }
+  const d = await res.json().catch(() => ({}));
+  if (res.status === 403 && /Login|not allowed|session/i.test(errorText(d, res)) && !window.__bsLoggedIn) {
+    throw new ApiError("Login required", 401);
+  }
+  if (res.status === 400 && /CSRF/i.test(JSON.stringify(d))) { csrf = null; return call(method, args, post); }
+  if (!res.ok) {
+    const err = new ApiError(errorText(d, res), res.status, d?.exc ? String(d.exc).slice(0, 4000) : undefined);
+    err.locked = res.status === 403 && /settings are locked/i.test(err.message);
+    throw err;
+  }
+  return d.message as T;
+}
+
+export const get = <T = any>(method: string, args?: Record<string, any>) => call<T>(method, args, false);
+export const post = <T = any>(method: string, args?: Record<string, any>) => call<T>(method, args, true);
+
+/** Download a CSV produced by a console_api method. */
+export function download(method: string, args: Record<string, any> = {}) {
+  const qs = new URLSearchParams();
+  Object.entries(args).forEach(([k, v]) => { if (v !== undefined && v !== null && v !== "") qs.set(k, String(v)); });
+  const a = document.createElement("a");
+  a.href = `/api/method/${M}${method}${qs.toString() ? "?" + qs : ""}`;
+  a.rel = "noopener";
+  document.body.appendChild(a);
+  a.click();
+  a.remove();
+}
+
+export async function login(usr: string, pwd: string) {
+  const res = await fetch("/api/method/login", {
+    method: "POST", credentials: "same-origin", headers: { "Content-Type": "application/json", Accept: "application/json" },
+    body: JSON.stringify({ usr, pwd }),
+  });
+  const d = await res.json().catch(() => ({}));
+  if (!res.ok) throw new ApiError(d.message || "Login failed", res.status);
+  csrf = null;
+}
+
+export async function logout() {
+  await fetch("/api/method/logout", { method: "POST", credentials: "same-origin" }).catch(() => {});
+}
+
+declare global {
+  interface Window { __bsLoggedIn?: boolean }
+}
