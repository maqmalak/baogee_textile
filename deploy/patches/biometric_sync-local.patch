+.task { display: grid; grid-template-columns: minmax(180px, 1.1fr) minmax(200px, 1.5fr) minmax(200px, 1.5fr) 96px; gap: 18px; align-items: center; padding: 14px 20px; border-top: 1px dashed var(--border); }
