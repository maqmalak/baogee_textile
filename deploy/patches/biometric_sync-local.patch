+  color-scheme: light;
+}
+
+:root[data-theme="dark"] {
+  --bg: #0b1018;
+  --surface: #131a25;
+  --surface-2: #18202d;
+  --surface-3: #1f2937;
+  --border: #253041;
+  --border-strong: #334155;
+  --text: #e6eaf0;
+  --text-2: #b4bfcd;
